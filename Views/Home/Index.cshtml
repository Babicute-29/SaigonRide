@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Home";
}

<h2 class="mb-4">Welcome</h2>

<!-- PROFILE CARD -->
<div class="card shadow p-4 mb-4" style="border-radius:15px;">
    <div class="row">

        <div class="col-md-6">
            <p class="text-muted">Full Name</p>
            <h5>@ViewBag.FullName</h5>

            <p class="text-muted mt-3">Phone</p>
            <h5>@ViewBag.Phone</h5>

            <p class="text-muted mt-3">Role</p>
            <h5>@Context.Session.GetString("Role")</h5>
        </div>

        <div class="col-md-6">
            <p class="text-muted">Email</p>
            <h5>@ViewBag.Email</h5>

            <p class="text-muted mt-3">Country</p>
            <h5>@ViewBag.Country</h5>
        </div>

    </div>
</div>

<!-- QUICK ACTIONS -->
<div class="card shadow p-4" style="border-radius:15px;">
    <h4 class="mb-4">Quick Actions</h4>

    <div class="row text-center">

        <div class="col-md-3">
            <a href="/Rental/Create" class="btn w-100 text-white"
                   style="background: linear-gradient(45deg,#2b6cf6,#1e40af); padding:15px; border-radius:10px;">
                View Available Vehicle
            </a>
        </div>

        <div class="col-md-3">
            <a href="#" class="btn w-100 text-white"
                   style="background: linear-gradient(45deg,#16a34a,#15803d); padding:15px; border-radius:10px;">
                My Active Rental
            </a>
        </div>

        <div class="col-md-3">
            <a href="#" class="btn w-100 text-white"
                   style="background: linear-gradient(45deg,#9333ea,#6b21a8); padding:15px; border-radius:10px;">
                My Rental History
            </a>
        </div>


    </div>
</div>