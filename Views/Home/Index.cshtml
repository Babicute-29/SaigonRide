@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Home";
}

<h2 class="mb-4">Welcome</h2>

<!-- PROFILE CARD -->
<div class="card shadow p-4 mb-4" style="border-radius:15px;">
    <div class="row">
        <div class="col-md-6">
            <p class="text-muted">Full Name</p>
            <h5>@ViewBag.FullName</h5>

            <p class="text-muted mt-3">Phone</p>
            <h5>@ViewBag.Phone</h5>

            <p class="text-muted mt-3">Role</p>
            <h5>@Context.Session.GetString("Role")</h5>
        </div>

        <div class="col-md-6">
            <p class="text-muted">Email</p>
            <h5>@ViewBag.Email</h5>

            <p class="text-muted mt-3">Country</p>
            <h5>@ViewBag.Country</h5>
        </div>
    </div>
</div>

<!-- QUICK ACTIONS -->
<div class="card shadow p-4" style="border-radius:15px;">
    <h4 class="mb-4">Quick Actions</h4>

    <div class="row text-center g-3">
        <!-- Nút 1: Xem danh sách xe để thuê -->
        <div class="col-md-4">
            <a href="/User/RentVehicle" class="btn w-100 text-white shadow-sm"
                   style="background: linear-gradient(45deg,#2b6cf6,#1e40af); padding:15px; border-radius:10px; border:none;">
                <i class="fa-solid fa-bicycle me-2"></i> View Available Vehicle
            </a>
        </div>

        <!-- Nút 2: Xem xe đang thuê hiện tại -->
        <div class="col-md-4">
            <a href="/User/MyRental" class="btn w-100 text-white shadow-sm"
                   style="background: linear-gradient(45deg,#16a34a,#15803d); padding:15px; border-radius:10px; border:none;">
                <i class="fa-solid fa-clock-rotate-left me-2"></i> My Active Rental
            </a>
        </div>

        <!-- Nút 3: Xem lịch sử -->
        <div class="col-md-4">
            <a href="/User/RentalHistory" class="btn w-100 text-white shadow-sm"
                   style="background: linear-gradient(45deg,#9333ea,#6b21a8); padding:15px; border-radius:10px; border:none;">
                <i class="fa-solid fa-history me-2"></i> My Rental History
            </a>
        </div>
    </div>
</div>