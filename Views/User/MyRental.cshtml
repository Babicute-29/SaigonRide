@model SaigonRide.Models.RentingHistory
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "My Active Rental";
}

<div class="container mt-5">
    <h2 class="fw-bold text-primary mb-4"><i class="fa-solid fa-person-biking me-2"></i>Current Journey</h2>

    @if (Model == null)
    {
        <div class="card shadow-sm border-0 text-center p-5" style="border-radius: 15px;">
            <div class="card-body">
                <i class="fa-solid fa-bicycle fa-4x text-light mb-3"></i>
                <h4 class="text-muted">You don't have any active rentals at the moment.</h4>
                <a href="/User/RentVehicle" class="btn btn-primary mt-3 px-4 py-2" style="border-radius: 10px;">Rent a Vehicle Now</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Vehicle Information -->
            <div class="col-md-5">
                <div class="card shadow border-0 p-4 mb-4" style="border-radius: 20px; background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);">
                    <h5 class="text-muted small text-uppercase fw-bold mb-3">Vehicle Details</h5>
                    <h3 class="fw-bold text-dark">@Model.Vehicle?.VehicleName</h3>
                    <p class="badge bg-primary">@Model.Vehicle?.Type</p>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Pickup Station:</span>
                        <span class="fw-bold">@Model.PickupStation?.StationName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Start Time:</span>
                        <span class="fw-bold">@Model.StartTime.ToString("HH:mm | MMM dd, yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Timer & Billing Stats -->
            <div class="col-md-7">
                <div class="card shadow border-0 text-center p-4" style="border-radius: 20px;">
                    <h5 class="text-muted small text-uppercase fw-bold mb-4">Journey Stats</h5>
                    
                    <div class="row">
                        <div class="col-6 border-end">
                            <p class="text-muted mb-1">Time Elapsed</p>
                            <h2 class="fw-bold text-primary" id="timer">00:00:00</h2>
                        </div>
                        <div class="col-6">
                            <p class="text-muted mb-1">Estimated Cost</p>
                            <h2 class="fw-bold text-danger" id="cost">0 VNĐ</h2>
                            <small class="text-success fw-bold">(15% Discount Applied)</small>
                        </div>
                    </div>

                    <div class="mt-5">
                        <form asp-action="ReturnVehicle" asp-controller="UserController" method="post">
                            <input type="hidden" name="historyId" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold py-3 shadow"
                                    style="border-radius: 15px;"
                                    onclick="return confirm('Do you want to end your journey and return this vehicle?')">
                                <i class="fa-solid fa-flag-checkered me-2"></i> Finish & Return Vehicle
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Lấy thời gian bắt đầu (định dạng chuẩn để JS không bị lỗi)
            const startTimeStr = "@Model.StartTime.ToString("yyyy-MM-ddTHH:mm:ss")";
            const startTime = new Date(startTimeStr).getTime();
            
          
            const vehicleType = "@Model.Vehicle?.Type";
            const ratePerMinute = (vehicleType === "E-Scooter") ? 1500 : 500;

            function updateStats() {
                const now = new Date().getTime();
                const diff = now - startTime;

                if (isNaN(diff)) return;

                // 1. Tính toán thời gian
                const hours = Math.floor(diff / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                const timerTxt = (hours < 10 ? "0" + hours : hours) + ":" +
                                 (minutes < 10 ? "0" + minutes : minutes) + ":" +
                                 (seconds < 10 ? "0" + seconds : seconds);
                
                const timerElement = document.getElementById("timer");
                if (timerElement) timerElement.innerHTML = timerTxt;

              
                const totalMinutes = diff / (1000 * 60);
                let basePrice = totalMinutes * ratePerMinute;
                let discountedPrice = basePrice * 0.85; 

                // Đảm bảo luôn tính ít nhất 1 phút để đúng logic kinh doanh
                let finalDisplay = Math.max(ratePerMinute * 0.85, discountedPrice);
                
                const costElement = document.getElementById("cost");
                if (costElement) {
                    costElement.innerHTML = Math.round(finalDisplay).toLocaleString() + " VNĐ";
                }
            }

            updateStats();
            setInterval(updateStats, 1000);
        });
    </script>
}