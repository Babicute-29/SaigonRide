@model SaigonRide.Models.RentingHistory
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "My Active Rental";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="container mt-5">
    <h2 class="fw-bold text-primary mb-4"><i class="fa-solid fa-person-biking me-2"></i>Current Journey</h2>

    @if (Model == null)
    {
        <div class="card shadow-sm border-0 text-center p-5" style="border-radius: 15px;">
            <div class="card-body">
                <i class="fa-solid fa-bicycle fa-4x text-light mb-3"></i>
                <h4 class="text-muted">You don't have any active rentals at the moment.</h4>
                <a href="/User/RentVehicle" class="btn btn-primary mt-3 px-4 py-2" style="border-radius: 10px;">Rent a Vehicle Now</a>
            </div>
        </div>
    }
    else
    {
        <div class="row" id="mainJourneyArea">
            <div class="col-md-5">
                <div class="card shadow border-0 p-4 mb-4" style="border-radius: 20px; background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);">
                    <h5 class="text-muted small text-uppercase fw-bold mb-3">Vehicle Details</h5>
                    <h3 class="fw-bold text-dark">@Model.Vehicle?.VehicleName</h3>
                    <p class="badge bg-primary px-3 py-2">@Model.Vehicle?.Type</p>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Pickup Station:</span>
                        <span class="fw-bold">@Model.PickupStation?.StationName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Start Time:</span>
                        <span class="fw-bold">@Model.StartTime.ToString("HH:mm | MMM dd, yyyy")</span>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <button class="btn btn-outline-warning w-100 fw-bold py-2" data-bs-toggle="modal" data-bs-target="#reportModal" style="border-radius: 12px;">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i> Report Issue / Support
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card shadow border-0 text-center p-4 mb-4" style="border-radius: 20px;">
                    <h5 class="text-muted small text-uppercase fw-bold mb-4">Journey Stats</h5>
                    <div class="row">
                        <div class="col-6 border-end">
                            <p class="text-muted mb-1">Time Elapsed</p>
                            <h2 class="fw-bold text-primary" id="timer">00:00:00</h2>
                        </div>
                        <div class="col-6">
                            <p class="text-muted mb-1">Estimated Cost</p>
                            <h2 class="fw-bold text-danger" id="cost">0 VNĐ</h2>
                            <small class="text-success fw-bold">(15% Discount Applied)</small>
                        </div>
                    </div>

                    <div class="mt-5">
                        <button type="button" class="btn btn-danger btn-lg w-100 fw-bold py-3 shadow"
                                style="border-radius: 15px;" onclick="handleReturn()">
                            <i class="fa-solid fa-flag-checkered me-2"></i> Finish & Return Vehicle
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="paymentArea" class="d-none animate__animated animate__fadeIn">
            <div class="card shadow-lg border-0 p-4" style="border-radius: 25px;">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-danger mb-1">TRẢ XE THÀNH CÔNG!</h3>
                    <p class="text-muted small">Xem lại lộ trình và quét mã QR để hoàn tất thanh toán</p>
                </div>

                <div class="rounded-4 overflow-hidden border mb-4 shadow-sm" style="height: 300px;" id="map"></div>

                <div class="text-center">
                    <h2 class="display-5 fw-bold text-dark mb-4" id="finalPrice">0 VNĐ</h2>

                    <div class="d-flex justify-content-center gap-4 mb-4">
                        <button class="btn btn-outline-primary px-4 py-2 rounded-pill fw-bold d-flex align-items-center justify-content-center"
                                onclick="showQR('vietqr')"
                                style="width: 180px; height: 50px;">
                            <img src="~/images/VietQR_Logo.png" height="22" alt="VietQR">
                        </button>

                        <button class="btn btn-outline-info px-4 py-2 rounded-pill fw-bold text-dark d-flex align-items-center justify-content-center"
                                onclick="showQR('paypal')"
                                style="width: 180px; height: 50px;">
                            <img src="~/images/PayPal_Logo.png" width="70" alt="PayPal">
                        </button>
                    </div>

                    <div id="qrDisplay" class="d-none animate__animated animate__zoomIn">
                        <div class="bg-white p-3 d-inline-block rounded-4 border shadow-sm mb-4">
                            <img id="qrImg" src="" style="width: 250px;" class="img-fluid" alt="Payment QR">
                        </div>
                        
                        <form asp-action="ReturnVehicle" asp-controller="User" method="post">
                            <input type="hidden" name="historyId" value="@Model.Id" />
                            <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold py-3 rounded-pill shadow">
                                XÁC NHẬN ĐÃ THANH TOÁN
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/User/SendSupport" method="post" class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-warning text-dark border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-headset me-2"></i>Report an Issue</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="VehicleId" value="@Model?.VehicleId" />
                <div class="mb-3">
                    <label class="form-label fw-bold small text-uppercase">Describe the problem</label>
                    <textarea name="Message" class="form-control border-2" rows="4" placeholder="..." required></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 p-4">
                <button type="submit" class="btn btn-warning w-100 py-2 fw-bold" style="border-radius: 10px;">SEND REPORT</button>
            </div>
        </form>
    </div>
</div>

@if (Model != null)
{
    <script>
        let isFinished = false;
        let finalCostString = "0";
        let mapInitialized = false;

        document.addEventListener("DOMContentLoaded", function () {
        const startTime = new Date("@Model.StartTime.ToString("yyyy-MM-ddTHH:mm:ss")").getTime();
        const vehicleType = "@Model.Vehicle?.Type";
        const ratePerMinute = (vehicleType === "E-Scooter") ? 1500 : 500;

        function updateStats() {
        if (isFinished) return;
        const now = new Date().getTime();
        const diff = now - startTime;
        if (isNaN(diff) || diff < 0) return;

        const h = Math.floor(diff / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);

        document.getElementById("timer").innerHTML =
        `${h < 10 ? '0' + h : h}:${m < 10 ? '0' + m : m}:${s < 10 ? '0' + s : s}`;

        const totalMinutes = Math.max(1, diff / 60000);
        let finalPrice = (totalMinutes * ratePerMinute) * 0.85;
        finalCostString = Math.round(finalPrice).toLocaleString() + " VNĐ";
        document.getElementById("cost").innerHTML = finalCostString;
        }
        setInterval(updateStats, 1000);
        });

        function handleReturn() {
        if (confirm("Do you want to end your journey and return this vehicle?")) {
        isFinished = true;
        document.getElementById("mainJourneyArea").classList.add("d-none");
        document.getElementById("paymentArea").classList.remove("d-none");
        document.getElementById("finalPrice").innerText = finalCostString;
                
        if (!mapInitialized) {
        setTimeout(initTrackingMap, 300);
        mapInitialized = true;
        }
        }
        }

        function initTrackingMap() {
        var startPoint = [10.7327, 106.6992];
        var endPoint = [10.7626, 106.6602];
        var map = L.map('map').setView(endPoint, 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        L.circleMarker(startPoint, { radius: 8, color: "#28a745", fillColor: "#28a745", fillOpacity: 1 }).addTo(map).bindPopup("Pickup Station");
        L.marker(endPoint).addTo(map).bindPopup("<b>Return Point</b>").openPopup();

        var route = L.polyline([startPoint, endPoint], { color: '#007bff', dashArray: '10, 10', opacity: 0.6 }).addTo(map);
        map.fitBounds(route.getBounds(), { padding: [40, 40] });
        }

        function showQR(method) {
        const qrDisplay = document.getElementById("qrDisplay");
        const qrImg = document.getElementById("qrImg");
        qrDisplay.classList.remove("d-none");

        // Lấy số tiền thực tế (Xóa chữ VNĐ và dấu chấm)
        const rawPrice = document.getElementById("finalPrice").innerText.replace(/[^0-9]/g, "");

        if (method === 'vietqr') {
        // Sử dụng API VietQR động
        let baseUrl = "@Html.Raw(ViewBag.MomoQr)";
        // Cập nhật số tiền và thêm tham số để ẩn thông tin thừa (tùy API VietQR.io)
        qrImg.src = baseUrl.replace("amount=0", "amount=" + rawPrice);
        } else {
        qrImg.src = "@Html.Raw(ViewBag.PaypalQr)";
        }
            
        setTimeout(() => {
        qrDisplay.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
        }
    </script>
}