@model IEnumerable<SaigonRide.Models.Vehicle>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Vehicles";
    // Lấy danh sách trạm từ ViewBag để dùng cho Dropdown
    var stations = ViewBag.Stations as List<SaigonRide.Models.Station> ?? new List<SaigonRide.Models.Station>();
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold"><i class="fa-solid fa-bicycle"></i> Vehicle Management</h2>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
            <i class="fa-solid fa-plus-circle"></i> Add New Vehicle
        </button>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-success border-4" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow border-0 mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Vehicle Name</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Current Station</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.VehicleName</td>
                                <td>
                                    <span class="badge @(item.Type == "E-Scooter" ? "bg-warning text-dark" : "bg-info text-dark")">
                                        <i class="fa-solid @(item.Type == "E-Scooter" ? "fa-bolt" : "fa-bicycle")"></i> @item.Type
                                    </span>
                                </td>
                                <td><span class="badge rounded-pill bg-success-subtle text-success px-3">@item.Status</span></td>
                                <td>
                                    @{
                                        var stationName = stations.FirstOrDefault(s => s.Id == item.StationId)?.StationName ?? "N/A";
                                    }
                                    <span class="text-secondary fw-semibold">@stationName</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#editVehicleModal"
                                            onclick="fillVehicleModal('@item.Id', '@item.VehicleName', '@item.Type', '@item.Status', '@item.StationId')">
                                        <i class="fa-solid fa-edit"></i> Edit
                                    </button>
                                    <a href="/Admin/DeleteVehicle/@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this vehicle?')">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Vehicle -->
<div class="modal fade" id="addVehicleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/Admin/CreateVehicle" method="post" class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold">Create New Vehicle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3"><i class="fa-solid fa-info-circle"></i> Name will be generated automatically (ESxx for E-Scooter, SDxx for Standard).</p>
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">Vehicle Type</label>
                    <select name="Type" class="form-select border-2">
                        <option value="Standard">Standard Bike</option>
                        <option value="E-Scooter">E-Scooter</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Station</label>
                    <select name="StationId" class="form-select border-2" required>
                        <option value="">-- Choose a Station --</option>
                        @foreach (var s in stations)
                        {
                            <option value="@s.Id">@s.StationName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="submit" class="btn btn-success px-4">Save Vehicle</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Edit Vehicle -->
<div class="modal fade" id="editVehicleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/Admin/EditVehicle" method="post" class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">Edit Vehicle Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="Id" id="edit-v-id">
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">Vehicle Name</label>
                    <input type="text" name="VehicleName" id="edit-v-name" class="form-control border-2 bg-light" readonly>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">Type</label>
                    <select name="Type" id="edit-v-type" class="form-select border-2">
                        <option value="Standard">Standard Bike</option>
                        <option value="E-Scooter">E-Scooter</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Move to Station</label>
                    <select name="StationId" id="edit-v-station" class="form-select border-2" required>
                        @foreach (var s in stations)
                        {
                            <option value="@s.Id">@s.StationName</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="Status" id="edit-v-status" class="form-select border-2">
                        <option value="Available">Available</option>
                        <option value="Maintenance">Maintenance</option>
                        <option value="Rented">Rented</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="submit" class="btn btn-primary px-4">Update Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function fillVehicleModal(id, name, type, status, stationId) {
            document.getElementById('edit-v-id').value = id;
            document.getElementById('edit-v-name').value = name;
            document.getElementById('edit-v-type').value = type;
            document.getElementById('edit-v-status').value = status;
            document.getElementById('edit-v-station').value = stationId;
        }
    </script>
}