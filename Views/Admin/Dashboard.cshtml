@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<h2>Admin Dashboard</h2>

<div class="row mt-4">

    <div class="col-md-3">
        <div class="card text-white p-3 shadow"
             style="background:linear-gradient(45deg,#2563eb,#1e3a8a);">
            <h5>Total Vehicles</h5>
            <h3>25</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white p-3 shadow"
             style="background:linear-gradient(45deg,#16a34a,#14532d);">
            <h5>Total Users</h5>
            <h3>50</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white p-3 shadow"
             style="background:linear-gradient(45deg,#9333ea,#581c87);">
            <h5>Total Stations</h5>
            <h3>10</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white p-3 shadow"
             style="background:linear-gradient(45deg,#f97316,#9a3412);">
            <h5>Total Rentals</h5>
            <h3>120</h3>
        </div>
    </div>

</div>