@model IEnumerable<SaigonRide.Models.Station>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Stations";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-4">
        <h2 class="text-primary fw-bold"><i class="fa-solid fa-map-location-dot"></i> Station Management</h2>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addStationModal">
            <i class="fa-solid fa-plus-circle"></i> Add New Station
        </button>
    </div>

    <!-- PHẦN THÔNG BÁO LỖI/THÀNH CÔNG NE NHU -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            <strong>Error:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-success border-4" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i>
            <strong>Success:</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Station Table Card -->
    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 font-weight-bold text-secondary">Registered Stations List</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="stationTable">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th>Station Name</th>
                            <th>Location</th>
                            <th>Capacity</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.StationName</td>
                                <td class="text-muted">@item.Location</td>
                                <td><span class="badge bg-info text-dark">@item.Capacity Slots</span></td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success px-3">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-warning px-3">Maintenance</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary shadow-sm me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editStationModal"
                                            onclick="fillEditModal('@item.Id', '@item.StationName', '@item.Location', '@item.Capacity', '@item.Status')">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </button>
                                    
                                    <a href="/Admin/DeleteStation/@item.Id" class="btn btn-sm btn-outline-danger shadow-sm"
                                           onclick="return confirm('Are you sure you want to delete this station?')">
                                        <i class="fa-solid fa-trash-can"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add New Station -->
<div class="modal fade" id="addStationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/Admin/CreateStation" method="post" class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle"></i> Create New Station</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Station Name</label>
                    <input type="text" name="StationName" class="form-control border-2" placeholder="Enter station name..." required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Location (Address)</label>
                    <input type="text" name="Location" class="form-control border-2" placeholder="e.g., District 1, HCMC" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Max Vehicle Capacity</label>
                    <input type="number" name="Capacity" class="form-control border-2" value="20" min="1" required>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success px-4">Save Station</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Edit Existing Station -->
<div class="modal fade" id="editStationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/Admin/EditStation" method="post" class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square"></i> Edit Station Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="Id" id="edit-id">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Station Name</label>
                    <input type="text" name="StationName" id="edit-name" class="form-control border-2" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Location</label>
                    <input type="text" name="Location" id="edit-location" class="form-control border-2" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Max Capacity</label>
                    <input type="number" name="Capacity" id="edit-capacity" class="form-control border-2" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Operational Status</label>
                    <select name="Status" id="edit-status" class="form-select border-2">
                        <option value="Active">Active</option>
                        <option value="Maintenance">Maintenance</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary px-4">Update Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function fillEditModal(id, name, location, capacity, status) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-location').value = location;
            document.getElementById('edit-capacity').value = capacity;
            document.getElementById('edit-status').value = status;
        }
    </script>
}