<!DOCTYPE html>
<html>
<head>
    <title>SaigonRide</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Thêm FontAwesome để mấy cái icon hiện lên cho đẹp nhen Nhu -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
            .navbar-lightblue {
                background-color: #ADD8E6; /* xanh dương nhạt */
            }
            /* Thêm chút hiệu ứng khi hover chuột vào menu cho chuyên nghiệp */
            .nav-link {
                color: #333 !important;
                font-weight: 500;
            }

                .nav-link:hover {
                    color: #007bff !important;
                }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-lightblue shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/Home/Index">
                <i class="fa-solid fa-motorcycle me-2"></i>SaigonRide
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index">
                            <i class="fa-solid fa-house me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <!-- Sửa lại link này để khớp với UserController -->
                        <a class="nav-link" href="/User/RentVehicle">
                            <i class="fa-solid fa-bicycle me-1"></i> Vehicle Rental
                        </a>
                    </li>
                    <li class="nav-item">
                        <!-- Sửa lại link này để xem xe đang thuê -->
                        <a class="nav-link" href="/User/MyRental">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i> My Rental
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/User/RentalHistory">
                            <i class="fa-solid fa-history me-1"></i> History
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center">
                    <span class="me-3 text-dark small">Hi, <strong>@Context.Session.GetString("FullName")</strong></span>
                    <a href="/Auth/Logout" class="btn btn-outline-danger btn-sm">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Chỗ này để load nội dung của RentVehicle hoặc Index nè -->
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>