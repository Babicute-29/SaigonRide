<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - SaigonRide</title>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
            /* Custom styles for SaigonRide Admin */
            .navbar-brand {
                font-weight: bold;
                color: #ffc107 !important; /* Yellow like Saigon sun */
                letter-spacing: 1px;
            }

            .nav-link {
                font-size: 0.95rem;
                transition: 0.3s;
            }

                .nav-link:hover {
                    color: #ffc107 !important;
                }

            .navbar {
                border-bottom: 3px solid #ffc107;
            }
            /* Style for the active Welcome message */
            .admin-name {
                color: #ffffff;
                font-size: 0.85rem;
                border-right: 1px solid rgba(255,255,255,0.2);
                padding-right: 15px;
            }
    </style>
</head>
<body>
    <!-- Navbar with Light background -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Admin/Dashboard">
                <i class="fa-solid fa-motorcycle"></i> SAIGON-RIDE
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Admin/Dashboard">
                            <i class="fa-solid fa-gauge"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Admin/ManageVehicle">
                            <i class="fa-solid fa-bicycle"></i> Vehicles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Admin/ManageStation">
                            <i class="fa-solid fa-charging-station"></i> Stations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Admin/ManageUser">
                            <i class="fa-solid fa-users"></i> Users
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center">
                    <span class="text-muted me-3 small">
                        Admin: <strong>@Context.Session.GetString("FullName")</strong>
                    </span>
                    <a href="/Auth/Logout" class="btn btn-outline-danger btn-sm">
                        <i class="fa-solid fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DÒNG QUAN TRỌNG NHẤT ĐỂ FIX LỖI SCRIPTS NE NHU -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>