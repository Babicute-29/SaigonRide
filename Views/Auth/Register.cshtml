@{
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #f3f6fb;
    }

    .card {
        width: 400px;
    }
</style>

<div class="card p-4 shadow">
    <h4 class="text-center">Sign Up</h4>

    <form method="post">
        <input class="form-control mb-2" name="FullName" placeholder="Full Name" required />
        <input class="form-control mb-2" name="Email" placeholder="Email" required />
        <input class="form-control mb-2" type="password" name="Password" placeholder="Password" required />
        <input class="form-control mb-2" name="Phone" placeholder="Phone" required />

        <select class="form-control mb-2" id="country" name="Country">
            <option value="Vietnam">Vietnam</option>
            <option value="Other">Other</option>
        </select>

        <input class="form-control mb-2" id="passport" name="Passport" placeholder="Passport" style="display:none;" />

        <button class="btn btn-success w-100">Register</button>
    </form>

    <p class="text-danger text-center">@ViewBag.Error</p>

    <div class="text-center">
        <a href="/Auth/Login">Back to Login</a>
    </div>
</div>

<script>
    const country = document.getElementById("country");
    const passport = document.getElementById("passport");

    country.addEventListener("change", function () {
        if (this.value !== "Vietnam") {
            passport.style.display = "block";
            passport.required = true;
        } else {
            passport.style.display = "none";
            passport.required = false;
        }
    });
</script>