@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - SaigonRide</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body {
            /* Nền màu Gradient xanh dịu, không gây mỏi mắt */
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
        }

        .login-container {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
            width: 100%;
            max-width: 400px;
            padding: 40px;
        }

        .brand-name {
            font-size: 2rem;
            font-weight: 800;
            color: #2b6cf6;
            text-align: center;
            margin-bottom: 30px;
        }
        .brand-name span { color: #16a34a; }

        /* Style ô nhập liệu sao cho đẹp */
        .form-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

        .form-control-custom {
            width: 100%;
            padding: 14px 15px 14px 45px;
            background: #f8f9fa;
            border: 2px solid #f8f9fa;
            border-radius: 12px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-control-custom:focus {
            background: #fff;
            border-color: #2b6cf6;
            outline: none;
            box-shadow: 0 0 0 4px rgba(43, 108, 246, 0.1);
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
            transition: 0.3s;
        }

        .form-control-custom:focus + .input-icon {
            color: #2b6cf6;
        }

        .btn-login {
            background: #2b6cf6;
            color: white;
            border: none;
            border-radius: 12px;
            padding: 14px;
            width: 100%;
            font-weight: 600;
            margin-top: 10px;
            transition: 0.3s;
        }

        .btn-login:hover {
            background: #1e40af;
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(43, 108, 246, 0.2);
        }

        .error-text {
            color: #e11d48;
            font-size: 0.85rem;
            text-align: center;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="brand-name">Saigon<span>Ride</span></div>
        
        <p class="text-center text-muted mb-4 small">Ready for your next journey?</p>

        @if (TempData["Error"] != null)
        {
            <div class="error-text">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["Error"]
            </div>
        }

        <form asp-action="Login" asp-controller="Auth" method="post">
            <div class="form-group-custom">
                <input type="email" name="email" class="form-control-custom" placeholder="Email Address" required>
                <i class="fa-solid fa-envelope input-icon"></i>
            </div>

            <div class="form-group-custom">
                <input type="password" name="password" class="form-control-custom" placeholder="Password" required>
                <i class="fa-solid fa-lock input-icon"></i>
            </div>

            <button type="submit" class="btn-login">Sign In</button>
        </form>

        <p class="text-center mt-4 mb-0 small text-muted">
            Don't have an account? <a href="/Auth/Register" class="text-primary fw-bold text-decoration-none">Register</a>
        </p>
    </div>

</body>
</html>